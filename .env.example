# .env.example
#
# Copy to `.env` (gitignored) and fill in values.
# The deploy script (infra/scripts/deploy.sh) will validate required keys
# before anything else runs.
#
# Naming inherited from MyFAL where applicable: DOMAIN, LETSENCRYPT_EMAIL, TZ,
# COMPOSE_PROJECT_NAME.

# ── Core ─────────────────────────────────────────────────────────
DOMAIN=myclash.fr
LETSENCRYPT_EMAIL=webmaster@example.com
TZ=Europe/Paris
COMPOSE_PROJECT_NAME=myclash

# Cookie signing secret (used by NestJS API for httpOnly cookies)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-cookie-secret

# Supabase URL (Kong gateway — internal Docker network in prod, localhost in dev)
# Dev: http://localhost:8000  |  Prod: https://app.${DOMAIN}
SUPABASE_URL=http://localhost:8000

# ── Postgres ─────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=myclash

# ── Redis ────────────────────────────────────────────────────────
# Used by BullMQ for background job queues (HEMA Ratings sync, etc.)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # uncomment if Redis requires auth

# ── Supabase (self-hosted) ───────────────────────────────────────
# Generate with:
#   openssl rand -base64 32   (for JWT secret — must be ≥32 chars)
#   openssl rand -base64 64   (for SECRET_KEY_BASE)
#
# For local dev, the anon/service-role keys are JWTs signed with
# SUPABASE_JWT_SECRET. Generate them with:
#   node -e "
#     const jwt = require('jsonwebtoken');
#     const s = process.env.SUPABASE_JWT_SECRET;
#     console.log('anon:', jwt.sign({role:'anon',iat:1613531985,exp:4769205985},s));
#     console.log('service:', jwt.sign({role:'service_role',iat:1613531985,exp:4769205985},s));
#   "
# Or use the Supabase CLI: supabase start (generates all keys automatically)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_REALTIME_SECRET=a-very-long-secret-key-base-for-realtime-at-least-64-chars-long-here
SUPABASE_ANON_KEY=change-me-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-jwt

# ── MyClash guest sessions ───────────────────────────────────────
# Separate secret used to sign guest-session JWTs. Keeping this distinct
# from SUPABASE_JWT_SECRET ensures guest sessions can NEVER be promoted
# into Supabase auth tokens, even if the Supabase secret is compromised.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MYCLASH_GUEST_JWT_SECRET=change-me-guest-jwt-secret

# Separate secret used to sign local event staff JWTs for scoring tablets.
# These tokens are not Supabase Auth tokens and only authorize assigned Lice actions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MYCLASH_STAFF_JWT_SECRET=change-me-staff-jwt-secret

# ── Resend (transactional email) ────────────────────────────────
# Get your API key at https://resend.com
# Domain myclash.fr must be verified in Resend before sending from noreply@myclash.fr
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=noreply@myclash.fr

# ── SMTP (GoTrue internal emails — password reset, email change) ─
# Recommended providers: Resend (3000/mo free), Brevo (300/day free)
# For Resend SMTP bridge: host=smtp.resend.com, port=587, user=resend, pass=<api-key>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=

# ── Google OAuth (optional) ──────────────────────────────────────
# Set GOOGLE_OAUTH_ENABLED=true to enable Google login.
# Google Cloud Authorized redirect URI:
#   https://app.myclash.fr/auth/v1/callback
# Self-hosted GoTrue app callback allow-list is configured in Docker Compose.
# See OWNER_TASKS.md O-008 for setup steps.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Web Push (VAPID) ─────────────────────────────────────────────
# Auto-generated by infra/scripts/deploy.sh on first deploy.
# Pre-populated values can also be put here (preserved if non-empty).
# Generate manually with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── HEMA Ratings sync ────────────────────────────────────────────
HEMA_RATINGS_SYNC_ENABLED=true

# ── Backup — Scaleway S3 ─────────────────────────────────────────
# Nightly backup uploads Postgres dump + storage volume to Scaleway Object Storage.
# Set up a Scaleway account, create a bucket, and generate an API key:
#   https://console.scaleway.com/object-storage/buckets
#   https://console.scaleway.com/iam/api-keys
#
# Scaleway S3-compatible endpoint format:
#   s3.<region>.scw.cloud  (e.g. s3.fr-par.scw.cloud)
#
# The aws-cli is used (S3-compatible). Install on VPS:
#   apt-get install -y awscli
# Then configure credentials in ~/.aws/credentials for the deploy user,
# OR set them as env vars here (they are passed to the backup script).
BACKUP_SCW_ACCESS_KEY=
BACKUP_SCW_SECRET_KEY=
BACKUP_SCW_BUCKET=myclash-backups
BACKUP_SCW_REGION=fr-par
BACKUP_SCW_ENDPOINT=https://s3.fr-par.scw.cloud
# Retention in days (default 60)
BACKUP_RETENTION_DAYS=60
# Internal secret used only between the API and the private ops-runner container.
# Auto-generated by infra/scripts/deploy.sh on first deploy.
OPS_RUNNER_SECRET=change-me-ops-runner-secret
# Backup upload limits in bytes (default 1 GiB).
BACKUP_UPLOAD_MAX_BYTES=1073741824
MULTIPART_MAX_BYTES=1073741824
# Optional: encrypt backups with GPG before upload
# BACKUP_GPG_RECIPIENT=your@email.com

# ── Next.js public vars (browser-accessible) ────────────────────
# These must match the corresponding server-side vars above.
# NEXT_PUBLIC_SUPABASE_URL must be reachable from the browser:
#   Dev (no Docker): http://localhost:8000
#   Dev (Docker):    https://myclash.localhost  (via Traefik)
#   Prod:            https://myclash.fr         (routed by Traefik to Kong)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me-anon-jwt
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Bootstrap super admin ────────────────────────────────────────
# Created automatically on first deploy by infra/scripts/deploy.sh.
# SEED_ADMIN_EMAIL is prompted interactively if not set.
# SEED_ADMIN_PASSWORD is auto-generated and stored here — save it!
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=change-me-admin-password

# ── AI infrastructure ─────────────────────────────────────────────
# 32-byte hex secret for AES-256-GCM encryption of provider API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_KEY_SECRET=

# ── Build metadata (auto-set by deploy script) ───────────────────
GIT_COMMIT=

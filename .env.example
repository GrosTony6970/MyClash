# .env.example
#
# Copy to `.env` (gitignored) and fill in values.
# The deploy script (infra/scripts/deploy.sh) will validate required keys
# before anything else runs.
#
# Naming inherited from MyFAL where applicable: DOMAIN, LETSENCRYPT_EMAIL, TZ,
# COMPOSE_PROJECT_NAME.

# ── Core ─────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=webmaster@example.com
# Days-until-expiry threshold for the TLS certificate monitor + admin card
# ("expiring soon" below this). Optional; defaults to 21.
TLS_CERT_MIN_DAYS=21
TZ=Europe/Paris
COMPOSE_PROJECT_NAME=myclash

# Traefik dashboard basic auth (required when dashboard is enabled)
# Auto-generated by infra/scripts/deploy.sh when missing or still set to the sample value.
# Generate: echo $(htpasswd -nB admin) | sed -e 's/\$/\$\$/g'
# Then paste the full "user:$$2y$$..." string below.
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$changeme
# The same password in plaintext. Written by the same pass that writes the hash
# above — never edit one without the other, or the dashboard becomes unreachable.
# Traefik itself never reads this; it is what lets `pnpm infra:plugins -- --deep`
# query the dashboard API without prompting the operator.
TRAEFIK_DASHBOARD_PASSWORD=

# Supabase Studio basic auth — the DB console on studio.${DOMAIN}.
# Same hash+plaintext pair as the dashboard above, auto-generated by deploy.sh.
# Studio ships with NO login of its own, so this and the IP allowlist are the
# only things standing in front of a superuser SQL editor. Never point a router
# at Studio without both.
#
# The allowlist is NOT set here: infra/scripts/lib/traefik-env.sh derives
# TRAEFIK_STUDIO_ALLOWLIST from THROTTLE_IP_WHITELIST further down, so an
# address added there for rate-limit exemption also reaches this login prompt.
STUDIO_BASIC_AUTH=admin:$$2y$$05$$changeme
STUDIO_PASSWORD=

# Cookie signing secret (used by NestJS API for httpOnly cookies)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-cookie-secret

# Supabase URL (Kong gateway — internal Docker network in prod, localhost in dev)
# Dev: http://localhost:8000  |  Prod: https://app.${DOMAIN}
SUPABASE_URL=http://localhost:8000

# Direct server-side GoTrue URL for API password login.
# Prod Docker: http://supabase-auth:9999
SUPABASE_AUTH_INTERNAL_URL=http://supabase-auth:9999

# ── Postgres ─────────────────────────────────────────────────────
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=myclash

# ── Redis ────────────────────────────────────────────────────────
# Used by BullMQ for background job queues (HEMA Ratings sync, etc.)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # uncomment if Redis requires auth

# ── Supabase (self-hosted) ───────────────────────────────────────
# Generate with:
#   openssl rand -base64 32   (for JWT secret — must be ≥32 chars)
#   openssl rand -base64 64   (for SECRET_KEY_BASE)
#
# For local dev, the anon/service-role keys are JWTs signed with
# SUPABASE_JWT_SECRET. Generate them with:
#   node -e "
#     const jwt = require('jsonwebtoken');
#     const s = process.env.SUPABASE_JWT_SECRET;
#     console.log('anon:', jwt.sign({role:'anon',iat:1613531985,exp:4769205985},s));
#     console.log('service:', jwt.sign({role:'service_role',iat:1613531985,exp:4769205985},s));
#   "
# Or use the Supabase CLI: supabase start (generates all keys automatically)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_REALTIME_SECRET=a-very-long-secret-key-base-for-realtime-at-least-64-chars-long-here
# Realtime encrypts internal tenant/extension metadata with this key.
# Auto-generated by infra/scripts/deploy.sh when missing or still set to the sample value.
# Generate with: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
SUPABASE_REALTIME_DB_ENC_KEY=change-me-realtime-db-enc-key
SUPABASE_ANON_KEY=change-me-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-jwt

# ── API authentication guard ─────────────────────────────────────
# AuthGuard runs on every request and 401s callers with no identity unless the
# route is marked @Public().
#   shadow  (default) — logs the 401 it WOULD have thrown, changes nothing.
#   enforce           — actually rejects.
# Leave on `shadow` until the `auth-shadow would-401` log lines are clean for a
# real event; flipping back to `shadow` is the rollback if enforce misbehaves.
AUTH_GUARD_MODE=shadow

# ── MyClash guest sessions ───────────────────────────────────────
# Separate secret used to sign guest-session JWTs. Keeping this distinct
# from SUPABASE_JWT_SECRET ensures guest sessions can NEVER be promoted
# into Supabase auth tokens, even if the Supabase secret is compromised.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MYCLASH_GUEST_JWT_SECRET=change-me-guest-jwt-secret

# Separate secret used to sign local event staff JWTs for scoring tablets.
# These tokens are not Supabase Auth tokens and only authorize assigned Lice actions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MYCLASH_STAFF_JWT_SECRET=change-me-staff-jwt-secret

# ── Resend (transactional email) ────────────────────────────────
# Get your API key at https://resend.com
# Domain myclash.fr must be verified in Resend before sending from noreply@myclash.fr
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=noreply@yourdomain.com

# ── SMTP (GoTrue internal emails — password reset, email change) ─
# Recommended providers: Resend (3000/mo free), Brevo (300/day free)
# For Resend SMTP bridge: host=smtp.resend.com, port=587, user=resend, pass=<api-key>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=

# ── Google OAuth (optional) ──────────────────────────────────────
# Set GOOGLE_OAUTH_ENABLED=true to enable Google login.
# Google Cloud Authorized redirect URI:
#   https://app.myclash.fr/auth/v1/callback
# Self-hosted GoTrue app callback allow-list is configured in Docker Compose.
# See OWNER_TASKS.md O-008 for setup steps.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Web Push (VAPID) ─────────────────────────────────────────────
# Auto-generated by infra/scripts/deploy.sh on first deploy.
# Pre-populated values can also be put here (preserved if non-empty).
# Generate manually with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── HEMA Ratings sync ────────────────────────────────────────────
HEMA_RATINGS_SYNC_ENABLED=true

# ── API rate limiting ────────────────────────────────────────────
# Comma-separated client IPs exempt from EVERY rate limit, including the
# per-IP and per-email login limits (e.g. the organizer's network running
# bulk imports / demo population, or the prod E2E suite unpaced).
# This is the only source of the whitelist — nothing is hardcoded, because
# the repo is public. Leave empty unless you need an exemption.
#
# It ALSO governs the Traefik edge: infra/scripts/lib/traefik-env.sh derives
# TRAEFIK_BAN_ALLOWLIST from it, so these IPs are exempt from Fail2Ban bans too.
# One trusted-IP list for both layers — otherwise the proxy could ban an address
# the app deliberately waves through. Do not set TRAEFIK_BAN_ALLOWLIST by hand.
THROTTLE_IP_WHITELIST=

# ── Traefik edge plugins ─────────────────────────────────────────
# GeoBlock + Fail2Ban are declared in the traefik service's static config and
# fetched from GitHub at container start, so a fresh deploy comes up with them
# already installed. The fetch is allowed to fail without stopping Traefik.
#
# But a router referencing a middleware whose plugin didn't load serves 404, so
# if the fetch fails the deploy scripts print a warning and this switch detaches
# the plugin middlewares to restore availability (unprotected but alive):
#   TRAEFIK_PLUGINS=off ./infra/scripts/start.sh
# Leave unset (or 'on') for normal operation.
#TRAEFIK_PLUGINS=on

# ── Backup — Scaleway S3 ─────────────────────────────────────────
# Nightly backup uploads Postgres dump + storage volume to Scaleway Object Storage.
# Set up a Scaleway account, create a bucket, and generate an API key:
#   https://console.scaleway.com/object-storage/buckets
#   https://console.scaleway.com/iam/api-keys
#
# Scaleway S3-compatible endpoint format:
#   s3.<region>.scw.cloud  (e.g. s3.fr-par.scw.cloud)
#
# The aws-cli is used (S3-compatible). Install on VPS:
#   apt-get install -y awscli
# Then configure credentials in ~/.aws/credentials for the deploy user,
# OR set them as env vars here (they are passed to the backup script).
BACKUP_SCW_ACCESS_KEY=
BACKUP_SCW_SECRET_KEY=
BACKUP_SCW_BUCKET=myclash-backups
BACKUP_SCW_REGION=fr-par
BACKUP_SCW_ENDPOINT=https://s3.fr-par.scw.cloud
# Retention in days (default 60)
BACKUP_RETENTION_DAYS=60
# Internal secret used only between the API and the private ops-runner container.
# Auto-generated by infra/scripts/deploy.sh on first deploy.
OPS_RUNNER_SECRET=change-me-ops-runner-secret
# Backup upload limits in bytes (default 1 GiB).
BACKUP_UPLOAD_MAX_BYTES=1073741824
MULTIPART_MAX_BYTES=1073741824
# Optional: encrypt backups with GPG before upload
# BACKUP_GPG_RECIPIENT=your@email.com

# ── Next.js public vars (browser-accessible) ────────────────────
# These must match the corresponding server-side vars above.
# Auto-generated by infra/scripts/deploy.sh from ${DOMAIN} when
# missing or still set to the sample value. Operator-supplied
# overrides are preserved across re-runs.
#
# NEXT_PUBLIC_SUPABASE_URL must be reachable from the browser:
#   Dev (no Docker): http://localhost:8000
#   Dev (Docker):    https://myclash.localhost  (via Traefik)
#   Prod:            https://app.${DOMAIN}      (routed by Traefik to Kong)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me-anon-jwt

# Per-app API URLs. Three keys instead of one so each app's
# build can target its own routing convention.
# Auto-generated by infra/scripts/deploy.sh from ${DOMAIN}.
#
#   Dev (no Docker): http://localhost:4000   (all three identical)
#   Prod:
#     web-admin   → https://admin.${DOMAIN}    (same-origin with admin UI)
#     web-public  → https://app.${DOMAIN}      (same-origin with public UI)
#     web-staff → https://api.${DOMAIN}      (dedicated API subdomain)
NEXT_PUBLIC_API_URL_ADMIN=http://localhost:4000
NEXT_PUBLIC_API_URL_PUBLIC=http://localhost:4000
NEXT_PUBLIC_API_URL_STAFF=http://localhost:4000

# Cross-app deep link to the scoring app: the admin's ScoringPad link and
# the staff sign-in links (admin staff page, public display hub + kiosk
# control layer) — a referee's event PIN only works there.
# Auto-generated by infra/scripts/deploy.sh from ${DOMAIN}.
# Baked into the admin AND public bundles at Docker build time — changing
# it requires a rebuild of @myclash/web-admin and @myclash/web-public.
# Required in production; next.config.ts fails the build when missing.
#   Dev (no Docker): http://localhost:3002
#   Dev (Docker):    https://staff.myclash.localhost
#   Prod:            https://staff.${DOMAIN}
NEXT_PUBLIC_STAFF_URL=http://localhost:3002

# Cross-app deep link from admin + scoring to the public app (event
# pages, fighter profiles, live match views).
# Auto-generated by infra/scripts/deploy.sh from ${DOMAIN}.
# Baked into admin + scoring bundles at Docker build time. Required
# in production; the build fails when missing.
#   Dev (no Docker): http://localhost:3001
#   Dev (Docker):    https://app.myclash.localhost
#   Prod:            https://app.${DOMAIN}
NEXT_PUBLIC_PUBLIC_APP_URL=http://localhost:3001

# Origin of the static marketing site (apex domain), which hosts the
# terms and the privacy policy. Admin + public link to them from their
# signup forms and footers, so a wrong value here is a legal link that
# 404s. Auto-generated by infra/scripts/deploy.sh from ${DOMAIN}.
# Required in production; both builds fail when missing.
#   Dev (no Docker): https://myclash.localhost
#   Dev (Docker):    https://myclash.localhost
#   Prod:            https://${DOMAIN}
NEXT_PUBLIC_MARKETING_URL=https://myclash.localhost

# ── Bootstrap super admin ────────────────────────────────────────
# Created automatically on first deploy by infra/scripts/deploy.sh.
# SEED_ADMIN_EMAIL is prompted interactively if not set.
# SEED_ADMIN_PASSWORD is auto-generated and stored here — save it!
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=change-me-admin-password

# ── AI infrastructure ─────────────────────────────────────────────
# 32-byte hex secret for AES-256-GCM encryption of provider API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_KEY_SECRET=

# Observability
# Optional — leave empty to disable Sentry capture. ensure-prod-env.mjs
# does NOT derive these; you create a Sentry project and paste the DSN
# here. Empty values are safe and the apps skip SDK init.
# Public DSNs are browser-visible by design; keep auth tokens
# and source-map upload credentials out of this file.
SENTRY_DSN_API=
NEXT_PUBLIC_SENTRY_DSN_ADMIN=
NEXT_PUBLIC_SENTRY_DSN_PUBLIC=
NEXT_PUBLIC_SENTRY_DSN_SCORING=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# Performance tracing. 0.05 samples 1 request in 20, which is what gives the
# per-route latency and slow-query spans this stack has no other source for —
# the Runtime Health card samples the machine, not individual requests, and
# Prometheus was deliberately not adopted (docs/OBSERVABILITY_REVIEW.md).
#
# ensure-prod-env.mjs only fills these when ABSENT. An existing .env carrying
# an explicit 0 keeps it, because 0 is a real value and not a sample — change
# it there by hand.
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Source-map upload token (BUILD-TIME ONLY; browsers never see it). Create a
# Sentry auth token scoped to project:releases + org:read and paste it here so
# client-side stack traces arrive UN-minified. Passed as a Docker build-arg to
# the three web apps and consumed by withSentryConfig; it is never added to any
# runtime environment. Leave empty to skip source-map upload (build still
# succeeds, but traces stay minified).
SENTRY_AUTH_TOKEN=

# ── Build metadata ───────────────────────────────────────────────
# Injected at deploy time as an EXPORTED SHELL VAR by deploy.sh / redeploy.sh
# (`export GIT_COMMIT=$(git rev-parse HEAD)`), which overrides this file during
# Compose interpolation. This line stays EMPTY on purpose — it is not written
# back. To verify the live value, inspect the running container, not this file:
#   docker inspect myclash-api --format '{{json .Config.Env}}' | tr ',' '\n' | grep -i git_commit
# A bare `docker compose build` (bypassing the scripts) falls back to "unknown".
GIT_COMMIT=

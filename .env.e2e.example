# ── Prod E2E test config ─────────────────────────────────────────
# Copy to `.env.e2e` (git-ignored) and fill in. In CI these come from secrets.
# Used by playwright.e2e.config.ts + tests/e2e/global-setup.ts.

# Base URL of the deployed admin app under test.
E2E_BASE_URL=https://admin.myclash.fr

# A DEDICATED, email-confirmed organizer/admin account on the target env.
# password-login requires organizer/admin access. Never use a real personal login.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Slug of an organization this account administers. Each run creates and then
# hard-deletes a throwaway event inside it — pick a sandbox org.
E2E_ORG_SLUG=

# Optional: path to a participants CSV to import. Leave blank and the import
# spec auto-uses tests/e2e/fixtures/participants.local.csv if present (your real
# roster, git-ignored), else the committed synthetic participants.sample.csv.
# Columns: given_name;family_name[;display_name;club;club_abv;club_city;...]
E2E_PARTICIPANTS_CSV=

# Optional: unique run id folded into the throwaway event slug.
# CI sets this to the workflow run id; leave blank for local runs.
E2E_RUN_ID=

# Optional: set to 1 to DELETE the test event after the run. Default (unset)
# PRESERVES it so you can inspect what was created in the admin UI. CI sets this.
E2E_CLEANUP=

# Optional: set to 1 to also run the demo-data populator (populate-event.spec.ts)
# — builds a rich published tournament + workshop (fighter-who-is-also-referee,
# skills, pool assignment, run matches, bracket, instructor, workshop). Off by
# default; it scores matches, so the event can no longer be hard-deleted.
E2E_POPULATE=

# ── Prod E2E test config ─────────────────────────────────────────
# Copy to `.env.e2e` (git-ignored) and fill in. In CI these come from secrets.
# Used by playwright.e2e.config.ts + tests/e2e/global-setup.ts.

# Base URL of the deployed admin app under test.
E2E_BASE_URL=https://admin.myclash.fr

# A DEDICATED, email-confirmed organizer/admin account on the target env.
# password-login requires organizer/admin access. Never use a real personal login.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Slug of an organization this account administers. Each run creates and then
# hard-deletes a throwaway event inside it — pick a sandbox org.
E2E_ORG_SLUG=

# Optional: path to a participants CSV to import. Leave blank and the import
# spec auto-uses tests/e2e/fixtures/participants.local.csv if present (your real
# roster, git-ignored), else the committed synthetic participants.sample.csv.
# Columns: given_name;family_name[;display_name;club;club_abv;club_city;...]
E2E_PARTICIPANTS_CSV=

# Optional: unique run id folded into the throwaway event slug.
# CI sets this to the workflow run id; leave blank for local runs.
E2E_RUN_ID=

# Optional: set to 1 to DELETE the test event after the run. Default (unset)
# PRESERVES it so you can inspect what was created in the admin UI. CI sets this.
E2E_CLEANUP=

# Optional: set to 1 to also run the demo-data populator (07-populate-event.spec.ts)
# — builds a rich published tournament + workshop (fighter-who-is-also-referee,
# skills, pool assignment, run matches, bracket, instructor, workshop). Off by
# default; it scores matches, so the event can no longer be hard-deleted.
E2E_POPULATE=

# Optional: set to 1 to also run the double-elimination playthrough
# (09-double-elim.spec.ts) — generates 4 structurally distinct double-elim
# brackets and plays every match against the real API, failing on any slot that
# never becomes playable. ~67 matches, ~5 min. Off by default; like the
# populator it completes matches, so the event can no longer be hard-deleted.
E2E_DOUBLE_ELIM=

# Optional: set to 1 to also run the scoring-pad server contract
# (10-scoring-pad.spec.ts) — drives the clock state machine, every exchange type,
# penalties, undo/void and best-of-N rounds through the pad's OWN endpoints,
# asserting after each mutation that the persisted score equals the derived one.
# ~20 s. The nightly runs it.
E2E_SCORING_PAD=

# Optional: set to 1 to also run the league specs (11-league.spec.ts and
# 29-league-multi-event.spec.ts). `11` plays two tournaments in ONE event and
# checks standings, club standings, the season report CSV, finalize/reopen and
# clone-to-new-season — the only test driving TournamentPlacementService against
# real played data. `29` spans THREE events, so the totals are real sums rather
# than a doubled roster: it drives every rung of the tie-break ladder, the bulk
# event link/unlink, and the event_kind gate that silently drops a club event's
# points. ~1.5 min together. The nightly runs them.
E2E_LEAGUE=

# Optional: set to 1 to also run the export surfaces (12-exports.spec.ts) — the
# tournament matches/exchanges/rankings CSVs, reconciled against the bracket and
# the exchanges that produced them, plus the HEMA Ratings pre-flight and .zip
# checked against their contract (no header row, raw fields, byte-identical
# names). ~20 s. The nightly runs it.
E2E_EXPORTS=

# Optional: set to 1 to also run the privacy spec (13-privacy.spec.ts) — checks
# the GDPR subject bundle against its own manifest and README, drives the
# deletion-request lifecycle on a disposable archived event, and asserts the
# destructive admin privacy routes refuse a non-super-admin. ~15 s. The nightly
# runs it.
E2E_PRIVACY=

# Optional: set to 1 to also run referee compensation (14-compensation.spec.ts)
# — builds a plan with role rates and tiers, assigns a referee to a pool, plays
# four of its six matches, and checks the payout, the tier band, the floor, the
# cap and the paid round-trip. ~25 s. The nightly runs it.
E2E_COMPENSATION=

# Optional: set to 1 to also run the public site (15-public-site.spec.ts) — it
# publishes its own club-kind event, plays a tournament, and reads the result
# back off the deployed public app: event home, the bracket and final-ranking
# tabs, /organisers, /o/<slug> and /me. ~25 s. The nightly runs it.
E2E_PUBLIC_SITE=

# Optional: set to 1 to also run the pad UI (16-pad-ui.spec.ts) — clicks the
# scoring pad's OTHER controls in a real browser: double, no exchange, afterblow,
# a penalty card, and the clock (start → halt → resume → end), asserting after
# each that the server holds the right row and that the persisted score equals
# the derived one. 06/08 only ever clicked the clean-hit button, which is why the
# payload bug that broke ALL FOUR exchange types reached production. ~40 s. The
# nightly runs it.
E2E_PAD_UI=

# Optional: set to 1 to also run the archive round-trip (17-archive-restore.spec.ts)
# — plays a tournament to a champion inside its own disposable test event,
# exports the archive, restores it, and checks the copy reproduces the original:
# persons copied under new ids, registrations, the bracket slot by slot, the
# champion by name, and every match result + exchange via the archive's own
# reports. Covers both restore paths (event scope and tournament scope, the
# latter both into its own event and into another). ~1 min. The nightly runs it.
E2E_ARCHIVE=

# Optional: set to 1 to also run the staff pad (18-staff-pad.spec.ts) — the
# referee's REAL login. Creates an event staff account with a known PIN, signs
# in through the pad's own login form in a browser carrying NO organizer cookie,
# scores a match on the assigned lice, and then holds the four staff rules apart
# by their reasons: another lice, no lice, another event, and a locked match the
# organizer can reopen but staff cannot. Every other scoring spec authenticates
# as the organizer, so none of that branch had ever run. ~2-3 min (it waits on
# the 60s auto-lock scan). The nightly runs it.
E2E_STAFF=

# Optional: set to 1 to also run workshops (19-workshops.spec.ts) — 31 endpoints
# that had zero assertions. Fills a 2-seat workshop with 5 people and checks WHO
# ends up in WHICH slot: arrival order on the waitlist, the freed seat going to
# the top of the queue with the rest re-numbered, refuse blocking re-registration,
# promote/accept, the two instructor identities (global vs event-scoped), breaks,
# and the status gate on the public list. Never touches workshops/:id/notify —
# that messages real people. ~30 s. The nightly runs it.
E2E_WORKSHOPS=

# Optional: set to 1 to also run the schedule + referee-board specs
# (20-schedule.spec.ts, 21-referee-assign.spec.ts). `04` asserts only
# `matchesScheduled > 0` and `05` has six assertions for 33 endpoints; these two
# hold the generator to the contract in match-scheduler.ts's own header — no
# lice running two matches at once, no fighter in two at once, minRestMinutes
# honoured, a pool kept on one piste — and the referee board to the two facts an
# organiser curates: qualification and availability, plus the lock. Each builds
# its own disposable `event_kind: 'test'` event, because both generators are
# event-wide. ~1 min. The nightly runs them.
E2E_SCHEDULE=

# Optional: set to 1 to also run the platform console (27-super-admin.spec.ts).
# Half A sweeps every SuperAdminGuard controller as the ordinary organizer and
# asserts each refuses with 403 specifically — the failure it exists to catch is
# a new admin controller that forgot the guard. Half B drives the console itself
# and only runs when the two credentials below are set. ~5 s. The nightly runs it.
E2E_SUPER_ADMIN=

# Optional: a SECOND account, holding a `platform_roles` row with
# role='super_admin'. Without it 27's console half SKIPS.
#
# Never promote E2E_ADMIN_EMAIL to super admin to avoid needing this: 13-privacy
# refuses to invoke retention/anonymise for real when the account it is running
# as is a super admin, so promoting the shared account silently disarms that
# interlock and makes its refusal assertions vacuous.
E2E_SUPERADMIN_EMAIL=
E2E_SUPERADMIN_PASSWORD=

# Optional: set to 1 to also run the live control room (28-live-control-room.spec.ts)
# — two pistes, one bout each, asserting each per-lice realtime channel actually
# reaches SUBSCRIBED and that scoring one piste patches only that piste. The
# board's 7 s poll means a wholly dead socket still LOOKS correct, so the proof
# is the channel's own console line, not the score. ~15 s. The nightly runs it.
E2E_LIVE_BOARD=

# Optional: base URL of the deployed web-public app. Defaults to
# https://app.myclash.fr; set it if the public app lives elsewhere.
E2E_PUBLIC_URL=

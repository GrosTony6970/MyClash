{
  // TYPECHECK surface — see packages/rulesets/tsconfig.json. It covers the
  // colocated tests; tsconfig.build.json is the narrower EMIT surface that
  // leaves them out.
  "extends": "../../tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

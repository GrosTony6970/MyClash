{
  // EMIT surface. `extends` replaces include/exclude, so both are restated in
  // full. This is also what `check-package-purity.mjs` reads: the purity rule is
  // over the EMIT PROGRAM, not over src/, because every colocated test imports
  // vitest and src/ would red on the package's own tests.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    // Test-only, but not named *.test.ts, so no glob catches it. Listed by path
    // on purpose: scripts/check-test-code-leak.mjs proves the list is complete
    // rather than trusting a naming convention. It no longer imports vitest, so
    // shipping it would not crash any more — it is simply not production code.
    "src/scheduling/double-elim-test-helpers.ts"
  ]
}

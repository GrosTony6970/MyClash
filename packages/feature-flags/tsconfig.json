{
  // TYPECHECK surface — see packages/rulesets/tsconfig.json. This package has no
  // tests today; it still carries the split so that a missing
  // tsconfig.build.json is always a gate failure rather than sometimes
  // legitimate, and so the first test added here cannot silently reach dist.
  "extends": "../../tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

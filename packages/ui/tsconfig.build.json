{
  // EMIT surface — see packages/rulesets/tsconfig.build.json. `extends`
  // replaces include/exclude, so both are restated in full.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Drops the Node globals the typecheck config grants for its disk-reading
    // parity tests. This package ships into browser bundles: nothing that
    // reaches dist may reference process, Buffer or node: modules.
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx"]
}

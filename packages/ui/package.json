  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}

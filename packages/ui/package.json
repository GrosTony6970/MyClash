{
  "name": "@myclash/ui",
  "version": "0.0.0",
  "private": true,
  "description": "MyClash shared UI components (shadcn/ui based).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "echo 'lint: no sources yet'",

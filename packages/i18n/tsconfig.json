{
  // The ONE package with no tsconfig.build.json, deliberately. Every other
  // packages/* splits typecheck from emit so test code stays out of dist (see
  // packages/rulesets/tsconfig.json) — this one cannot: its `test` script is
  // `pnpm build && node dist/index.test.js && …`, so the compiled tests in dist
  // ARE the test runner. It has no vitest config at all.
  //
  // Safe to leave: packages/i18n/dist is copied into no production image — the
  // web apps ship Next standalone output, which traces from entry points.
  // scripts/check-test-code-leak.mjs carries this as a named exemption; if this
  // package ever gains a vitest config, delete the exemption and split it.
  "extends": "../../tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // TypeScript 6 changed the DEFAULT of `types` from "every package found
    // under every typeRoot" to effectively []. Nothing is included ambiently
    // any more — not even an @types package sitting in node_modules/@types next
    // to this tsconfig. typeRoots still resolves names, but only ones listed
    // here. So the Node globals and node: imports these compiled tests rely on
    // (assert, fs, path, Buffer, process) have to be named explicitly.
    //
    // Scoped to this package rather than tsconfig.lib.json for dependency
    // hygiene, NOT because a missing type package would error: with no
    // typeRoots configured, the root node_modules/@types is a default typeRoot
    // for every workspace, so `types: ["node"]` in the shared config would
    // compile clean everywhere while making each packages/* silently rely on a
    // hoisted package it never declared — a phantom dependency that a stricter
    // layout or a per-package Docker install would break.
    //
    // Do not add this to packages/rulesets, schedule-core or time: they ship
    // into browser bundles, and granting them Node globals would let
    // process.env/Buffer compile in offline scoring code.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

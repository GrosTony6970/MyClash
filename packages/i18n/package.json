{
  "name": "@myclash/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "MyClash shared i18n translation strings.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./staff": {
      "types": "./dist/surfaces/staff.d.ts",
      "default": "./dist/surfaces/staff.js"
    },
    "./public": {
      "types": "./dist/surfaces/public.d.ts",
      "default": "./dist/surfaces/public.js"
    },
    "./admin": {
      "types": "./dist/surfaces/admin.d.ts",
      "default": "./dist/surfaces/admin.js"
    },
    "./messages/*": {
      "types": "./dist/messages/*.d.ts",
      "default": "./dist/messages/*.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "echo 'lint: no sources yet'",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node dist/index.test.js && node dist/encoding.test.js && node dist/no-literal-string-rule.test.js && node dist/t-key-references.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}

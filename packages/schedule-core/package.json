{
  "name": "@myclash/schedule-core",
  "version": "0.0.0",
  "private": true,
  "description": "MyClash shared schedule-grid geometry + block model (pure). Consumed by web-admin and web-public.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json",
    "lint": "echo 'lint: no sources yet'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@myclash/time": "workspace:^"
  }
}

{
  "name": "@myclash/rulesets",
  "version": "0.0.0",
  "private": true,
  "description": "MyClash ruleset engine — TF_v1 and plugin contract.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scheduling": {
      "types": "./dist/scheduling/index.d.ts",
      "default": "./dist/scheduling/index.js"
    },
    "./scheduling/conflict-check": {
      "types": "./dist/scheduling/conflict-check.d.ts",
      "default": "./dist/scheduling/conflict-check.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json",
    "lint": "echo 'lint: no sources yet'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@myclash/rules": "workspace:^",
    "@myclash/types": "workspace:^",
    "zod": "^4.4.3"
  }
}

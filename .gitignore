# ── Secrets and local config ─────────────────────────────────────
.env
.env.bak
.env.local
.env.deploy
.env.e2e
.env.*.local

# Prod E2E session + run context (created by tests/e2e/global-setup.ts)
tests/e2e/.auth/
# Real participant rosters used for import tests stay local (contain PII)
tests/e2e/fixtures/*.local.csv

# ── MyClash runtime data (matches MyFAL pattern) ─────────────────
data/
logs/
/backups/
.last-deploy.json
.last-deploy.json.rolled-back-*
.deploy.lock
cookies.txt
server.out
server.err

# ── Service-specific secrets ─────────────────────────────────────
infra/scripts/reference/myfal/*        # owner's MyFAL scripts (privacy)
!infra/scripts/reference/myfal/README.md
data/traefik/acme*.json
data/app/google-oauth-tokens.json
config/google-oauth-client.json


node_modules/
.pnpm-store/
.turbo/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# ── Test artefacts ───────────────────────────────────────────────
playwright-report/
test-results/
.nyc_output/

# ── Editor / OS ──────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/


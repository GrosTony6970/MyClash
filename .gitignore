# ── Secrets and local config ─────────────────────────────────────
.env
.env.bak
.env.local
.env.deploy
.env.e2e
.env.*.local

# Prod E2E session + run context (created by tests/e2e/global-setup.ts)
tests/e2e/.auth/
# Real participant rosters used for import tests stay local (contain PII)
tests/e2e/fixtures/*.local.csv

# ── MyClash runtime data (matches MyFAL pattern) ─────────────────
data/
logs/
/backups/
.last-deploy.json
.last-deploy.json.rolled-back-*
.deploy.lock
cookies.txt
server.out
server.err

# ── Service-specific secrets ─────────────────────────────────────
infra/scripts/reference/myfal/*        # owner's MyFAL scripts (privacy)
!infra/scripts/reference/myfal/README.md
data/traefik/acme*.json
data/app/google-oauth-tokens.json
config/google-oauth-client.json

# ── Node / pnpm / monorepo build outputs ─────────────────────────
node_modules/
.pnpm-store/
.turbo/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo
# Generated OpenAPI spec, written to the repo root by `pnpm openapi:emit`. The
# committed artefact is packages/api-client/src/generated/schema.ts, not this.
# Also needs a .prettierignore entry — Prettier does not read this file.
openapi.json

# ── Test artefacts ───────────────────────────────────────────────
playwright-report/
test-results/
.nyc_output/
# Page snapshots dumped by the Playwright MCP server during agent sessions.
.playwright-mcp/

# ── Editor / OS ──────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/

# ── Misc ─────────────────────────────────────────────────────────
*.log
*.pid
*.tgz
.eslintcache

# Claude Code
.claude/
.claude/settings.local.json
.claude/hooks/node_modules/
.claudeignore

# BMad Method local runtime (config, scripts, help catalog) — dev tooling,
# not product code. Keep out of this public repo. If your team wants to share
# the project config, un-ignore _bmad/config.yaml specifically (but never
# _bmad/config.user.yaml — that one is personal).
_bmad/

# BMad working output (brainstorming memlogs, session artifacts, generated
# project context). Local thinking, not product code — same reasoning as above.
_bmad-output/

# HEMA Ratings' own submission templates (Template.xlsx / Explanation.docx),
# downloaded for reference when building the ratings export. Third-party docs
# carrying example club and person rows — not our code, and not something to
# republish from a public repo. Keep them local.
hemaratings-export/
# Added by code-review-graph
.code-review-graph/

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // LOAD-BEARING, not just a speed knob. Turning it off (a plausible hardening
    // move) fails all three web apps inside third-party declarations: TS2430 in
    // @supabase/auth-js (webauthn.dom.d.ts), and TS2503 'JSX' in react-easy-crop
    // for web-admin and web-public (measured 2026-09-15). It also hides TS2882
    // from a local next-env.d.ts: Next writes that file (gitignored), and its
    // side-effect imports of ./.next/types/*.d.ts fail once .next is gone.
    "skipLibCheck": true,
    // TypeScript 6 flipped this default false -> true, so the check is already
    // live. Set explicitly so it is visible rather than an invisible default:
    // a new unresolvable side-effect import in a .ts/.tsx now hard-errors.
    "noUncheckedSideEffectImports": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".turbo", "coverage"]
}

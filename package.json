{
  "name": "myclash",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source platform for HEMA (Historical European Martial Arts) tournament management and result publication.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://myclash.fr",
  "repository": {
    "type": "git",
    "url": "https://github.com/GrosTony6970/MyClash.git"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "deploy:prod": "tsx scripts/deploy.ts",
    "rollback:prod": "tsx scripts/rollback.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:min": "tsx scripts/seed-min.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  }
}

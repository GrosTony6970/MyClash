{
  "name": "myclash",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source platform for HEMA (Historical European Martial Arts) tournament management and result publication.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://myclash.fr",
  "repository": {
    "type": "git",
    "url": "https://github.com/GrosTony6970/MyClash.git"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "deploy:prod": "tsx scripts/deploy.ts",
    "rollback:prod": "tsx scripts/rollback.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:min": "tsx scripts/seed-min.ts",
    "gen:api-client": "tsx scripts/gen-api-client.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.15.0",
    "@next/eslint-plugin-next": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@supabase/supabase-js": "^2.105.1",
    "@types/node": "^22.15.18",
    "dotenv": "^17.4.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lint-staged": "^16.4.0",
    "postgres": "^3.4.5",
    "prettier": "^3.3.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  }
}

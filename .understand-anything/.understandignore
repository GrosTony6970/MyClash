# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
# Lines below are suggestions — uncomment to activate.
# Use ! prefix to force-include something excluded by defaults.
#
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.
#

# --- From .gitignore (uncomment to exclude) ---

# .env
# .env.bak
# .env.local
# .env.deploy
# .env.*.local
# data/
# logs/
# /backups/
# .last-deploy.json
# .last-deploy.json.rolled-back-*
# .deploy.lock
# cookies.txt
# server.out
# server.err
# infra/scripts/reference/myfal/*        # owner's MyFAL scripts (privacy)
# !infra/scripts/reference/myfal/README.md
# data/traefik/acme*.json
# data/app/google-oauth-tokens.json
# config/google-oauth-client.json
# .pnpm-store/
# *.tsbuildinfo
# playwright-report/
# test-results/
# .nyc_output/
# .DS_Store
# *.swp
# *.swo
# *~
# .vscode/*
# !.vscode/extensions.json
# !.vscode/settings.json.example
# *.pid
# *.tgz
# .eslintcache
# .claude/settings.local.json
# .claude/hooks/node_modules/

# --- Detected directories (uncomment to exclude) ---

# docs/
# scripts/
# tests/

# --- Test file patterns (uncomment to exclude) ---

# JS / TS
# *.test.*
# *.spec.*
# *.snap
# C# / .NET
# **/*Tests.cs
# **/*Test.cs
# **/*Fixture.cs
# **/*.Tests.csproj
# Java / Kotlin
# **/src/test/**
# **/*Test.java
# **/*IT.java
# **/*Spec.kt
# Go
# **/*_test.go

# --- Active exclusions (added for full-monorepo run) ---
# Build / generated output (scanner walks the FS, not git)
.next/
.turbo/
*.tsbuildinfo
playwright-report/
test-results/
coverage/

# Tooling / agent config dirs — not project source
.agents/
.kiro/
.claude/
.understand-anything/

# Env / secrets / runtime data
.env
.env.*
data/
logs/
backups/

# Test files (excluded per user choice — production graph only)
*.test.*
*.spec.*
*.snap
tests/

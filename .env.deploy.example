# .env.deploy.example
#
# Local-machine deploy configuration. Copy to `.env.deploy` (gitignored).
# Used by `pnpm deploy:prod` (scripts/deploy.ts) to SSH into the VPS.

# OVH VPS hostname (or IP)
DEPLOY_HOST=myclash.fr

# Non-root deploy user on the VPS (created by infra/scripts/vps-bootstrap.sh)
DEPLOY_USER=deploy

# Path to the SSH key. Use ~/ for cross-platform home.
DEPLOY_SSH_KEY_PATH=~/.ssh/myclash_ed25519

# Where the MyClash repo is cloned on the VPS
DEPLOY_REPO_PATH=/srv/myclash

# Smoke-test URL hit from the local machine after deploy
DEPLOY_SMOKE_URL=https://api.myclash.fr/health

# ── Post-deploy edge review (scripts/check-edge-tls.mjs) ──────────────────
# Runs from THIS machine after the deploy: HTTPS redirects, HSTS, certificate
# trust + expiry, api/health, and realtime tenant resolution on app.<domain>.
# It runs here rather than in CI because admin.<domain> sits behind a
# fail-closed geoblock allow-list — only a machine in one of those countries
# can check the whole edge. A failure exits non-zero.

# Public domain to review. Defaults to DEPLOY_HOST.
# DEPLOY_EDGE_DOMAIN=myclash.fr

# Supabase anon key — public by construction (it ships in every browser
# bundle). Without it the realtime probe is skipped, and a dead websocket
# goes unnoticed again.
# SUPABASE_ANON_KEY=

# Set to 1 while prod is deliberately on `deploy.sh --dev-certs`: Let's Encrypt
# STAGING certificates are trusted by no browser, so the edge review fails on
# them by default. It stays reported as a warning either way. DELETE THIS LINE
# once real certificates are issued.
# DEPLOY_ALLOW_STAGING_CERT=1

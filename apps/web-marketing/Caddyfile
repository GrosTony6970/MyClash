# apps/web-marketing/Caddyfile
#
# Static multi-page site. NOT an SPA — and that distinction is the whole point
# of this file.
#
# What used to be here was `try_files {path} /index.html`, written inline in the
# Dockerfile as a printf one-liner. That is the SPA recipe: it rewrites anything
# that is not a file on disk to the homepage. `/terms` and `/privacypolicy` are
# directories, not files, so every request for either one was answered with the
# landing page — status 200, correct-looking, entirely the wrong document.
#
# Those two paths are not decorative. `packages/types/src/legal.ts` publishes
# them as `LEGAL_POLICIES[kind].path`, and `legal-url.ts` in web-public and
# web-admin builds every consent link and every LegalUpdateBanner href from
# them. So the app was asking people to accept a policy and then showing them
# the homepage, and nothing anywhere reported an error, because a 200 is not an
# error. A 404 would have been louder and therefore better.
#
# Order matters below. `try_files {path} {path}/index.html` would look correct
# and still be wrong: the file matcher counts a directory as existing, so
# `/terms` matches the first candidate, file_server sees a directory and answers
# 301 → `/terms/`. That contradicts the page's own
# `<link rel="canonical" href="https://myclash.fr/terms">` and leaves the URL in
# legal.ts one redirect away from the document it names. Trying the index file
# first serves `/terms/index.html` directly, 200, no redirect, URL unchanged.

:80 {
	root * /usr/share/caddy
	encode zstd gzip

	# GET /api/version — what this container is serving, matching the JSON the
	# three Next apps answer from `app/api/version/route.ts`. There is no server
	# here to run a handler, so Caddy answers it directly.
	#
	# `{env.GIT_COMMIT}` is read at RUNTIME from the container environment, not
	# baked in. That is deliberate and mirrors the Next apps: making the commit a
	# build arg would invalidate this image's layer cache on every commit, which
	# is the cost `infra/docker-compose.prod.yml` already refuses to pay for
	# SENTRY_RELEASE. The compose service passes GIT_COMMIT in `environment:`.
	#
	# In its own `handle` so it cannot fall into `try_files` below — which would
	# rewrite it to /api/version/index.html and answer 404.html. The static
	# serving keeps its original order inside the second `handle`; see the note
	# above for why that order is load-bearing.
	#
	# The commit is NOT truncated to 8 here, unlike the API and the Next apps:
	# the deploy scripts export a full `git rev-parse HEAD` and Caddy has no
	# string operations. It is a prefix of what the others print, so comparing
	# still works — read the first 8 characters.
	handle /api/version {
		header Content-Type application/json
		respond `{"app":"web-marketing","commit":"{env.GIT_COMMIT}"}` 200
	}

	handle {
		try_files {path}/index.html {path}
		file_server
	}

	# `status` is load-bearing: without it file_server serves 404.html with a
	# 200, which is the same soft-404 failure in a different costume — every
	# typo'd URL would still look to a crawler like a real page.
	handle_errors {
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}
}

---
import { Image } from 'astro:assets';
import logo from '../assets/Logo_nobackground.png';
import LangSwitch from './LangSwitch.astro';
import {
  CHROME,
  SECTION_IDS,
  localePath,
  APP_URL,
  CONTACT_EMAIL,
  ASSOCIATION_URL,
  LICENSE_URL,
  type Locale,
} from '../i18n/ui';

interface Props {
  locale: Locale;
  /**
   * Locale-independent route, so the language switch stays on this page.
   * `null` for a page with no counterpart in the other locale — the switcher
   * is then omitted rather than pointing at a URL that is not built.
   */
  route: string | null;
}

const { locale, route } = Astro.props;
const t = CHROME[locale];
const home = localePath(locale, '/');
const anchor = (id: string) => `${home === '/' ? '' : home}/#${id}`;
const year = 2026;
const association = locale === 'fr' ? 'Lyon AMHE' : 'Lyon HEMA';
const tagline = locale === 'fr' ? 'Gestionnaire de Tournois AMHE' : 'HEMA Tournament Manager';
const licence = locale === 'fr' ? 'Logiciel libre sous licence' : 'Free software licensed under';
const inspiredBy =
  locale === 'fr' ? 'Inspiré par Hemascorecard.' : 'Inspired by Hemascorecard.';
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__logo">
      <a href={home} aria-label={t.homeAria}>
        <Image src={logo} alt="MyClash" width={80} height={80} densities={[1, 2]} loading="lazy" />
      </a>
    </div>
    <ul class="footer__links" aria-label={t.footerNavAria}>
      <li><a href={anchor(SECTION_IDS.features)}>{t.navFeatures}</a></li>
      <li><a href={anchor(SECTION_IDS.howItWorks)}>{t.navHowItWorks}</a></li>
      <li><a href={anchor(SECTION_IDS.support)}>{t.navSupport}</a></li>
      <li><a href={APP_URL} target="_blank" rel="noopener">{t.footerApp}</a></li>
      <li><a href={localePath(locale, '/privacypolicy')}>{t.footerPrivacy}</a></li>
      <li><a href={localePath(locale, '/terms')}>{t.footerTerms}</a></li>
      {route !== null && (
        <li>
          <LangSwitch locale={locale} route={route} variant="footer" />
        </li>
      )}
    </ul>
    <a href={`mailto:${CONTACT_EMAIL}`} class="footer__contact">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
        ></path>
      </svg>
      {t.footerContact}
    </a>
  </div>
  <div class="footer__bottom">
    <div>
      {/*
        Was "Tous droits réservés" / "All rights reserved" on an AGPL-3.0
        project, which is the opposite of what the licence says. The licence is
        a selling point here, so it is stated rather than merely not-denied.
      */}
      <p class="footer__copy">
        © MyClash {year} — {tagline}. {licence}{' '}
        <a href={LICENSE_URL} target="_blank" rel="noopener">AGPL-3.0</a>.
      </p>
      <p class="footer__copy footer__copy--credit">
        {t.footerDevelopedBy}{' '}
        <a href={ASSOCIATION_URL} target="_blank" rel="noopener">{association}</a>. {inspiredBy}
      </p>
    </div>
    <div class="footer__badges">
      <span class="footer__badge">Open Source</span>
      <span class="footer__badge">{t.badgeHema}</span>
      <span class="footer__badge">Made in France</span>
    </div>
  </div>
</footer>

<style>
  /*
   * The credit line's link used inline `onmouseover`/`onmouseout` handlers that
   * wrote to element.style. Inline event attributes are the first thing a
   * Content-Security-Policy blocks, and this is a hover effect — it belongs in
   * CSS regardless.
   */
  .footer__copy--credit {
    margin-top: 0.3rem;
  }
  .footer__copy a,
  .footer__copy--credit a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: underline;
    transition: color 0.2s;
  }
  .footer__copy a:hover,
  .footer__copy a:focus-visible,
  .footer__copy--credit a:hover,
  .footer__copy--credit a:focus-visible {
    color: rgba(255, 255, 255, 0.9);
  }
</style>

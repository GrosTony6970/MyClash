---
/**
 * Switches to the other locale, staying on the same page.
 *
 * The landing pages had no switcher at all — the only cross-language link was
 * the `hreflang` metadata, which browsers use and readers cannot see. A French
 * visitor had to hand-edit the URL to reach /en. The legal pages already had
 * one, which is its own evidence that the two halves of the site were being
 * maintained separately.
 */
import { CHROME, localePath, LOCALES, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Locale-independent route, so the switch lands on the same document. */
  route: string;
  /** `nav` sits in the header bar, `footer` in the footer link row. */
  variant?: 'nav' | 'footer';
}

const { locale, route, variant = 'nav' } = Astro.props;
const other = LOCALES.find((candidate) => candidate !== locale) as Locale;
const t = CHROME[locale];
---

<a
  href={localePath(other, route)}
  hreflang={other}
  lang={other}
  class:list={['lang-switch', `lang-switch--${variant}`]}
  aria-label={t.switchAria}
>
  <span aria-hidden="true">{other === 'en' ? '🇬🇧' : '🇫🇷'}</span>
  {t.switchLabel}
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .lang-switch--nav {
    font-size: 0.7rem;
    color: var(--dark-mid);
  }
  .lang-switch--nav:hover,
  .lang-switch--nav:focus-visible {
    color: var(--blue);
  }

  .lang-switch--footer {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.55);
  }
  .lang-switch--footer:hover,
  .lang-switch--footer:focus-visible {
    color: var(--white);
  }
</style>

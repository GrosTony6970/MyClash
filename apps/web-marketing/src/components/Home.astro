---
import { Picture } from 'astro:assets';
import hero from '../assets/Hero_myclash.png';
import banner from '../assets/Banner.png';
import { HOME, FEATURE_ICON_PATHS, DONATION_URL } from '../i18n/home';
import {
  SECTION_IDS,
  APP_URL,
  ADMIN_URL,
  CONTACT_EMAIL,
  API_URL,
  type Locale,
} from '../i18n/ui';
import '../styles/home.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = HOME[locale];
const numberLocale = locale === 'fr' ? 'fr-FR' : 'en-GB';
const statsEndpoint = `${API_URL.replace(/\/+$/, '')}/api/v1/public/site-stats`;
---

<!-- HERO -->
<section class="hero" aria-labelledby="hero-title">
  {/*
    Was a CSS background-image on an empty div, invisible to the preload
    scanner. As a real element it can be eager + high priority, and Astro emits
    AVIF/WebP at several widths instead of one 2.37 MB PNG.
  */}
  <Picture
    src={hero}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[768, 1200, 1672]}
    sizes="100vw"
    alt={c.heroImageAlt}
    class="hero__bg"
    id="heroBg"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <p class="hero__eyebrow">{c.heroEyebrow}</p>
    <h1 class="hero__title" id="hero-title">
      {c.heroTitleLead}<br />
      <span>{c.heroTitleAccent}</span>
    </h1>
    <p class="hero__subtitle">{c.heroSubtitle}</p>
    {/*
      Two audiences, two destinations — the split the README always described
      and the page never shipped. Organisers go to the workspace where an event
      is created; everyone else goes to the public app to find one.
    */}
    <div class="hero__actions">
      <a href={ADMIN_URL} class="btn-primary" target="_blank" rel="noopener">{c.heroCtaPrimary}</a>
      <a href={APP_URL} class="btn-outline" target="_blank" rel="noopener">{c.heroCtaSecondary}</a>
    </div>
  </div>
  <div class="hero__scroll" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
    </svg>
    {c.heroScroll}
  </div>
</section>

<!-- STATS BAR -->
{/*
  Rendered empty and filled from the API, or removed outright.

  The three numbers here used to be 120 / 45 / 3 000, hardcoded as animation
  targets and untrue. Server-rendering a placeholder would reintroduce exactly
  that — a figure on screen that nothing substantiates — so the band ships with
  `hidden` and only appears once real counts arrive. No API, no band.
*/}
<section class="stats" id="site-stats" aria-labelledby="stats-heading" data-endpoint={statsEndpoint} data-locale={numberLocale} hidden>
  <h2 id="stats-heading" class="visually-hidden">{c.statsHeading}</h2>
  {
    c.statLabels.map((label, i) => (
      <div class="stat">
        <div class="stat__number" data-stat={['events', 'clubs', 'fighters'][i]}>
          &nbsp;
        </div>
        <div class="stat__label">{label}</div>
      </div>
    ))
  }
</section>

<!-- FEATURES -->
<section class="section section--grey" id={SECTION_IDS.features} aria-labelledby="features-title">
  <div class="section__header">
    <span class="section__tag">{c.featuresTag}</span>
    <h2 class="section__title" id="features-title">{c.featuresTitle}</h2>
    <p class="section__lead">{c.featuresLead}</p>
  </div>
  <div class="features__grid">
    {
      c.features.map((feature, i) => (
        <div class="feature-card" data-reveal>
          <div class="feature-card__icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              {(FEATURE_ICON_PATHS[i] ?? []).map((d) => (
                <path stroke-linecap="round" stroke-linejoin="round" d={d} />
              ))}
            </svg>
          </div>
          <h3 class="feature-card__title">{feature.title}</h3>
          <p class="feature-card__text">{feature.text}</p>
        </div>
      ))
    }
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section" id={SECTION_IDS.howItWorks} aria-labelledby="steps-title">
  <div class="section__header">
    <span class="section__tag">{c.stepsTag}</span>
    <h2 class="section__title" id="steps-title">{c.stepsTitle}</h2>
    <p class="section__lead">{c.stepsLead}</p>
  </div>
  <div class="steps">
    {
      c.steps.map((step, i) => (
        <div class="step" data-reveal>
          <div class="step__num" aria-hidden="true">
            {i + 1}
          </div>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__text">{step.text}</p>
        </div>
      ))
    }
  </div>
</section>

<!-- BANNER -->
<div class="banner-section" aria-hidden="true">
  <Picture
    src={banner}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[768, 1200, 1584]}
    sizes="100vw"
    alt=""
    loading="lazy"
  />
</div>

<!-- CTA -->
<section class="cta-section" aria-labelledby="cta-title">
  <span class="section__tag">{c.ctaTag}</span>
  <h2 class="section__title" id="cta-title">
    {c.ctaTitleLead}<br />{c.ctaTitleTail}
  </h2>
  <p class="section__lead">{c.ctaLead}</p>
  <div class="cta-section__actions">
    <a href={ADMIN_URL} class="btn-white" target="_blank" rel="noopener">{c.ctaPrimary}</a>
    <a href={`mailto:${CONTACT_EMAIL}`} class="btn-outline-white">{c.ctaSecondary}</a>
  </div>
</section>

<!-- CONTRIBUTION -->
<section class="contribution" id={SECTION_IDS.support} aria-labelledby="contrib-title">
  <div class="contribution__inner">
    <div class="contribution__left">
      <span class="section__tag">{c.contribTag}</span>
      <h2 class="section__title" id="contrib-title">{c.contribTitle}</h2>
      <p class="contribution__tagline">{c.contribTagline}</p>
      <ul class="contribution__list">
        {c.contribBullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
      <a href={DONATION_URL} class="contribution__donate" target="_blank" rel="noopener noreferrer">
        ♥ &nbsp;{c.contribDonate}
      </a>
    </div>
    <div class="contribution__right">
      {/*
        The paragraph that used to sit here repeated the highlight box below it
        almost word for word — "Every cent donated goes directly toward hosting
        costs and infrastructure maintenance", twice, back to back, in both
        languages. Said once.
      */}
      <h3 class="contribution__box-title">{c.contribBoxTitle}</h3>
      <div class="contribution__highlight" role="note">
        <span aria-hidden="true">💡</span>
        <span><strong>{c.contribHighlightLabel}</strong> {c.contribHighlightText}</span>
      </div>
      <h3 class="contribution__box-title contribution__box-title--tight">{c.contribHowTitle}</h3>
      <div class="contribution__types">
        {
          c.contribTypes.map((type, i) => (
            <div class="contribution__type">
              <span class:list={['contribution__type-badge', { monthly: i === 1 }]}>
                {type.badge}
              </span>
              <span>{type.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Hero zoom-in once the image has decoded.
  const heroBg = document.getElementById('heroBg');
  if (heroBg) {
    const markLoaded = () => heroBg.classList.add('loaded');
    if (heroBg instanceof HTMLImageElement && heroBg.complete) markLoaded();
    else heroBg.addEventListener('load', markLoaded, { once: true });
  }

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll-triggered reveal. The hidden start state is `.js [data-reveal]` in
  // base.css, so with scripting off nothing is ever hidden in the first place.
  const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (prefersReducedMotion) {
    revealables.forEach((el) => el.classList.add('visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          window.setTimeout(() => el.classList.add('visible'), Number(el.dataset.delay ?? 0));
          observer.unobserve(el);
        });
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll<HTMLElement>('.feature-card[data-reveal]').forEach((el, i) => {
      el.dataset.delay = String(i * 100);
      observer.observe(el);
    });
    document.querySelectorAll<HTMLElement>('.step[data-reveal]').forEach((el, i) => {
      el.dataset.delay = String(i * 150);
      observer.observe(el);
    });
  }

  /*
   * Live adoption counts.
   *
   * Every failure path ends the same way: the band stays hidden. A network
   * error, a non-200, a malformed body, or a zero count all mean "we cannot
   * substantiate a number right now", and the honest render of that is nothing
   * at all — never a placeholder, never a stale constant. That is the whole
   * reason these stopped being hardcoded.
   */
  interface SiteStats {
    events: number;
    clubs: number;
    fighters: number;
  }

  const band = document.getElementById('site-stats');

  function isUsable(value: unknown): value is number {
    return typeof value === 'number' && Number.isFinite(value) && value > 0;
  }

  async function loadStats(el: HTMLElement): Promise<void> {
    const endpoint = el.dataset.endpoint;
    if (!endpoint) return;

    let stats: SiteStats;
    try {
      const response = await fetch(endpoint, { headers: { accept: 'application/json' } });
      if (!response.ok) return;
      stats = (await response.json()) as SiteStats;
    } catch {
      return;
    }

    // All three or none: a band showing two real numbers and one blank reads
    // as broken, and inviting the reader to guess which is which is worse than
    // showing nothing.
    if (!isUsable(stats.events) || !isUsable(stats.clubs) || !isUsable(stats.fighters)) return;

    const format = new Intl.NumberFormat(el.dataset.locale || 'fr-FR');
    const targets = el.querySelectorAll<HTMLElement>('.stat__number[data-stat]');

    targets.forEach((target) => {
      const key = target.dataset.stat as keyof SiteStats;
      target.textContent = format.format(stats[key]);
    });

    el.hidden = false;

    if (prefersReducedMotion) return;

    // Count up only once the band is actually on screen. The final value is
    // already in the DOM before this runs, so an interrupted animation still
    // leaves the true number behind.
    const animate = (target: HTMLElement) => {
      const key = target.dataset.stat as keyof SiteStats;
      const value = stats[key];
      const duration = 1800;
      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        target.textContent = format.format(Math.round(eased * value));
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const watcher = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          targets.forEach(animate);
          watcher.unobserve(entry.target);
        });
      },
      { threshold: 0.5 },
    );
    watcher.observe(el);
  }

  if (band) void loadStats(band);
</script>

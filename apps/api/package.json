    "@myclash/feature-flags": "workspace:^",
    "@myclash/rulesets": "workspace:^",
    "@myclash/time": "workspace:^",
    "@myclash/types": "workspace:^",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-fastify": "^11.1.19",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/nestjs": "^10.53.1",

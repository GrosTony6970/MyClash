{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // TS 6 stopped including @types/* ambiently (see packages/i18n/tsconfig.json).
    // Without this, the ~70 process.env uses here compile only because a
    // transitive .d.ts happens to carry `/// <reference types="node" />`:
    // @nestjs/config -> dotenv-expand -> lib/main.d.ts. If either drops that,
    // this app takes 70+ TS2591 at once. @types/node is already a declared
    // devDependency, so naming it here is a verified no-op that makes the
    // dependency explicit instead of accidental.
    "types": ["node"],
    "tsBuildInfoFile": ".turbo/tsconfig.tsbuildinfo",
    // TYPECHECK surface: this config covers the colocated tests and the
    // test-only helpers, and emits nothing. tsconfig.build.json is the emit
    // surface and flips this back off — see the comment there. Keeping noEmit
    // here means a stray `tsc -p tsconfig.json` cannot repopulate dist with
    // compiled tests behind the build's back.
    "noEmit": true,
    // NestJS requires these two — override the bundler defaults from tsconfig.base.json
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}

{
  // Shared base for publishable workspace libraries (packages/*): Node runtime
  // module resolution + declaration emit. Path options (outDir/rootDir/
  // tsBuildInfoFile) stay per-package — `extends` resolves them relative to the
  // file that defines them, so they cannot be centralised here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true
  }
}
